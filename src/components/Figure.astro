---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="fig">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1650]}
    sizes="(max-width: 1120px) 100vw, 1056px"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    counter-increment: fig;
    margin: 32px 0;
  }
  .fig img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-demo);
  }
  figcaption {
    margin-top: 8px;
    font: 400 14px/1.5 var(--font-mono);
    color: var(--text-muted);
  }
  figcaption::before {
    content: 'Fig. ' counter(fig) '. ';
  }
</style>
