---
import { SITE } from '../site';
---

<footer id="contact" class="on-dark">
  <div class="inner">
    <ul>
      <li>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </li>
      <li>
        <a href={SITE.github}>GitHub</a>
      </li>
      <li>
        <a href={SITE.linkedin}>LinkedIn</a>
      </li>
      <li>
        <a href="/privacy/">Privacy</a>
      </li>
    </ul>
    <p>© 2026 Don Yuen</p>
  </div>
</footer>

<style>
  footer {
    background: var(--navy);
    color: var(--on-dark);
    padding: 24px 0;
    margin-top: 64px;
  }
  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  ul {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--amber-bright);
  }
  a:hover {
    color: var(--on-dark);
  }
  p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--on-dark-muted);
  }
</style>
