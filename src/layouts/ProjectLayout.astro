---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProblemApproachResult from '../components/ProblemApproachResult.astro';
import CardStrip from '../components/CardStrip.astro';
import MnistCard from '../components/mnist/MnistCard';

interface Props {
  project: CollectionEntry<'projects'>;
  relatedNotes: CollectionEntry<'notes'>[];
  next: CollectionEntry<'projects'> | null;
  showNotes: boolean;
}

const { project, relatedNotes, next, showNotes } = Astro.props;
const { id, data } = project;
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogImage={data.ogImage}
  showNotes={showNotes}
>
  <article class="page project">
    <header class="head">
      <CardStrip entry={data.entry} tags={data.tags} year={data.year} id={id} />
      <h1 transition:name={`project-${id}-title`}>{data.title}</h1>
    </header>

    {data.demo === 'mnist' && (
      <div id="demo">
        <MnistCard client:visible codeUrl={data.repo} fullDemoHref={null} />
        <p class="accuracy">
          98.32% is test-set accuracy, measured on the 10,000 MNIST test images.
          Digits you draw here are usually harder for the network, because they
          don't look quite like the scanned digits it trained on.
        </p>
      </div>
    )}

    <div class="par">
      <ProblemApproachResult
        problem={data.problem}
        approach={data.approach}
        result={data.result}
      />
    </div>

    <div class="writeup prose">
      <slot />
    </div>

    {relatedNotes.length > 0 && (
      <section class="prose related" aria-labelledby="related-notes">
        <h2 id="related-notes">Related notes</h2>
        <ul>
          {relatedNotes.map((note) => (
            <li>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {next && (
      <nav class="next" aria-label="More projects">
        <a href={`/projects/${next.id}/`}>
          <span class="next-label">Next project</span>
          <span class="next-title">{next.data.title}</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .head {
    margin-bottom: 32px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  h1 {
    padding: 24px;
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1.1;
    overflow-wrap: break-word;
  }
  #demo {
    margin-bottom: 32px;
  }
  .accuracy {
    max-width: 72ch;
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--text-muted);
  }
  .par {
    max-width: 72ch;
    margin-bottom: 8px;
  }
  .writeup {
    counter-reset: fig;
  }
  .writeup :global(img) {
    max-width: 100%;
    height: auto;
  }
  .next {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--divider);
  }
  .next a {
    display: inline-flex;
    flex-direction: column;
    min-height: 44px;
    text-decoration: none;
  }
  .next-label {
    font: 500 13px/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .next-title {
    font-size: 22px;
    font-weight: 600;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 24px;
    }
    h1 {
      padding: 16px;
    }
  }
</style>
