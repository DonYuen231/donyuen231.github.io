---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundNote from '../components/BackgroundNote.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MnistCard from '../components/mnist/MnistCard';
import { featured, loadSiteContent } from '../lib/content';

const { projects, showNotes } = await loadSiteContent();
const selected = featured(projects);
---

<BaseLayout
  title="Don Yuen"
  description="Don Yuen is a software engineer. Projects with demos you can try: a neural network written from scratch and an accessible photo explorer."
  showNotes={showNotes}
>
  <div class="page">
    <h1>Don Yuen</h1>
    <p class="intro">I build software and like to show how it works.</p>
    <BackgroundNote>
      <p>
        I took computer science courses at CUNY, where a Node.js assignment grew
        into a photo explorer for blind and visually impaired readers. Since
        then I've written a neural network in plain NumPy, to see exactly how a
        model learns.
      </p>
    </BackgroundNote>

    <h2>Selected work</h2>
    <ul class="cards">
      {selected.map((project) => (
        <li>
          {project.data.demo === 'mnist' ? (
            <ProjectCard project={project} variant="full">
              <div id="demo">
                <MnistCard client:visible codeUrl={project.data.repo} />
              </div>
            </ProjectCard>
          ) : (
            <ProjectCard project={project} variant="full" />
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 30ch;
    margin: 16px 0 0;
    font-size: clamp(21px, 3.4vw, 26px);
    line-height: 1.35;
  }
  .page :global(.note) {
    max-width: 72ch;
  }
  h2 {
    margin-top: 56px;
  }
  .cards {
    display: grid;
    gap: 32px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
