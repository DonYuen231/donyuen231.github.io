---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';

const { showNotes } = await loadSiteContent();
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist. Go back to Don Yuen's home page or see all projects."
  showNotes={showNotes}
  noindex
>
  <div class="page prose">
    <h1>Page not found</h1>
    <p class="lede">
      There's nothing at this address. The page may have moved, or the link may
      be wrong.
    </p>
    <ul class="links">
      <li>
        <a href="/">Go to the home page</a>
      </li>
      <li>
        <a href="/projects/">See all projects</a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .lede {
    margin-top: 16px;
    font-size: clamp(21px, 3.4vw, 26px);
    line-height: 1.35;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
