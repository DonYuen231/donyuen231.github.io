---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';

const { notes, showNotes } = await loadSiteContent();
const dateFormat = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Notes"
  description="Notes by Don Yuen on the projects he builds and what he learns along the way."
  showNotes={showNotes}
>
  <div class="page prose">
    <h1>Notes</h1>
    {notes.length === 0 ? (
      <p>No notes yet.</p>
    ) : (
      <ul class="list">
        {notes.map((note) => (
          <li>
            <h2>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </h2>
            <time datetime={note.data.date.toISOString().slice(0, 10)}>
              {dateFormat.format(note.data.date)}
            </time>
            <p>{note.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .list {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .list h2 {
    margin: 0;
    font-size: 24px;
  }
  .list a {
    display: inline-block;
    min-height: 44px;
  }
  time {
    font: 400 14px/1.5 var(--font-mono);
    color: var(--text-muted);
  }
  .list li {
    margin-bottom: 32px;
  }
</style>
